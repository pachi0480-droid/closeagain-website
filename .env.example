# Copy to .env.local (never commit real values).

# ── Public origin ────────────────────────────────────────────────────────────
# Usually leave this empty. On Vercel, a production build uses the project's
# production domain automatically (its custom domain once added, otherwise
# its .vercel.app address); preview builds stay noindex.
# Set it only to override that, e.g. https://www.your-domain.example
# With no origin (local builds, previews) every page is noindex, robots.txt
# disallows crawling, the sitemap is empty and no canonical URLs are emitted.
# Read at build time — redeploy after changing it.
NEXT_PUBLIC_SITE_URL=

# ── Where inquiries go (server-side only) ────────────────────────────────────
# Configure at least one before launch; with neither, the Contact to buy form
# can only open a pre-filled email in the visitor's own email app.
# A submission is confirmed to the visitor only when a destination accepts it.

# 1. Email, through Resend (free tier: resend.com). Each inquiry arrives as an
#    email listing every answer; Reply goes straight to the prospect.
#    Open the Resend account with the address inquiries should go to — until a
#    domain is verified, Resend's default sender can only email that address.
RESEND_API_KEY=
# Optional: where inquiries go (default: the business address in content/site.ts)
FORMS_NOTIFY_EMAIL=
# Optional: the sender, once you have verified a domain in Resend,
# e.g. CloseAgain <inquiries@your-domain.example>
# With it set, each prospect also gets a "we got your details" email
# (reply goes to you). Turn that part off with FORMS_CONFIRM_PROSPECT=off.
FORMS_EMAIL_FROM=
FORMS_CONFIRM_PROSPECT=

# 2. And/or a webhook: an HTTPS URL that accepts a JSON POST per inquiry
#    (a CRM, Zapier/Make, Formspree, or your own endpoint):
#   { "type": "inquiry",
#     "submittedAt": "<ISO time>",
#     "fields": { "name", "email", "business", "goal", "plan",
#                 "phone", "industry", "volume", "crm", "message" } }
# (every field is a string; optional ones may be empty). The full contract is
# documented in lib/forms/delivery.ts.
FORMS_WEBHOOK_URL=

# Optional shared secret, sent as "Authorization: Bearer <secret>".
FORMS_WEBHOOK_SECRET=

# Local testing only: `npm run forms:sink` starts a stand-in destination.
# FORMS_WEBHOOK_URL=http://127.0.0.1:4455/

# ── Visitor analytics (optional) ─────────────────────────────────────────────
# Vercel Web Analytics: cookieless page views. First enable it in the Vercel
# dashboard (Project → Analytics → Enable), then set this and redeploy. The
# privacy policy updates itself to match.
VERCEL_WEB_ANALYTICS=

# ── Booking link (optional) ──────────────────────────────────────────────────
# Your Calendly / Cal.com page (https). Adds "Prefer to talk first? Pick a
# time for a call" to Contact to buy. Nothing shows while it is empty.
NEXT_PUBLIC_BOOKING_URL=
