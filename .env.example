# Copy to .env.local (never commit real values).

# ── Public origin ────────────────────────────────────────────────────────────
# The verified production origin, e.g. https://www.your-domain.example
# Set it ONLY on the production deployment. While it is empty the site treats
# itself as a preview: every page is noindex, robots.txt disallows crawling,
# the sitemap is empty and no canonical URLs are emitted.
# Read at build time — rebuild after changing it.
NEXT_PUBLIC_SITE_URL=

# ── Form delivery (server-side only) ─────────────────────────────────────────
# HTTPS URL that accepts a JSON POST for each demo request and contact message:
#   { "type": "demo-request" | "contact-message",
#     "submittedAt": "<ISO time>",
#     "fields": { "name": "...", "email": "...", ... } }
# A submission is confirmed to the visitor only when this URL answers 2xx.
# While it is empty the forms say requests are temporarily unavailable.
FORMS_WEBHOOK_URL=

# Optional shared secret, sent as "Authorization: Bearer <secret>".
FORMS_WEBHOOK_SECRET=

# Local testing only: `npm run forms:sink` starts a stand-in destination.
# FORMS_WEBHOOK_URL=http://127.0.0.1:4455/
